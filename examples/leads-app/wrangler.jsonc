{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leads-app",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leads-app-db",
      // `npx wrangler d1 create leads-app-db` で発行される ID に差し替える
      // （./deploy.sh を使えば自動で書き込まれます）
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
